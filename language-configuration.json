{
  // RACE RESULT has no line-comment syntax, only /* ... */ blocks.
  "comments": {
    "blockComment": ["/*", "*/"]
  },
  // Braces are not a nesting bracket in RACE RESULT: {n} and {EN:..|ES:..}
  // are single tokens, so they are auto-closed but not bracket-matched.
  "brackets": [
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "/*", "close": " */", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""]
  ],
  "colorizedBracketPairs": [
    ["(", ")"],
    ["[", "]"]
  ],
  // Double-clicking [Contest.Name] selects the whole reference.
  "wordPattern": "\\[[^\\]]*\\]|[A-Za-z_][A-Za-z0-9_]*|[0-9]+(?:\\.[0-9]+)?",
  "indentationRules": {
    "increaseIndentPattern": "\\([^()]*$",
    "decreaseIndentPattern": "^\\s*\\)"
  }
}
