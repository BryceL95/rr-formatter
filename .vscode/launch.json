{
    "version": "0.2.0",
    "configurations": [
        {
            // Opens a second VS Code window with the extension loaded and the
            // examples folder open, so there is something to format straight away.
            "name": "Run Extension",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}",
                "${workspaceFolder}/examples"
            ],
            "outFiles": ["${workspaceFolder}/dist/**/*.js"],
            "preLaunchTask": "npm: compile"
        }
    ]
}
